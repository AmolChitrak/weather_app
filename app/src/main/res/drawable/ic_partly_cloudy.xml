<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="100%" height="100%">
    <defs>
        <!-- Sun Gradient -->
        <linearGradient id="sunGradient" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#FFE156" />
            <stop offset="50%" stop-color="#FFB703" />
            <stop offset="100%" stop-color="#FB8500" />
        </linearGradient>

        <!-- Cloud Gradient -->
        <linearGradient id="cloudGradient" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#FFFFFF" />
            <stop offset="60%" stop-color="#F0F4F8" />
            <stop offset="100%" stop-color="#D9E2EC" />
        </linearGradient>

        <!-- 3D Soft Drop Shadow -->
        <filter id="clayShadow" x="-20%" y="-20%" width="140%" height="140%">
            <feDropShadow dx="0" dy="16" stdDeviation="14" flood-color="#0F172A" flood-opacity="0.18" />
            <feDropShadow dx="0" dy="4" stdDeviation="4" flood-color="#0F172A" flood-opacity="0.10" />
        </filter>

        <!-- Inner Highlight for Clay Texture -->
        <filter id="innerHighlight" x="-20%" y="-20%" width="140%" height="140%">
            <feOffset dx="0" dy="-4"/>
            <feGaussianBlur stdDeviation="4" result="offset-blur"/>
            <feComposite operator="out" in="SourceGraphic" in2="offset-blur" result="inverse"/>
            <feFlood flood-color="#FFFFFF" flood-opacity="0.7" result="color"/>
            <feComposite operator="in" in="color" in2="inverse" result="shadow"/>
            <feComposite operator="over" in="shadow" in2="SourceGraphic"/>
        </filter>
    </defs>

    <!-- Sun Element (Behind Cloud) -->
    <g filter="url(#clayShadow)">
        <circle cx="340" cy="170" r="75" fill="url(#sunGradient)" />
        <!-- Subtle Sun Rays / Accents -->
        <circle cx="340" cy="170" r="62" fill="none" stroke="#FFF" stroke-opacity="0.3" stroke-width="4" stroke-dasharray="10 10" />
    </g>

    <!-- Main Cloud Element (In Front) -->
    <g filter="url(#clayShadow)">
        <path d="M 140 330
             H 360
             A 55 55 0 0 0 415 275
             A 45 45 0 0 0 395 195
             A 65 65 0 0 0 280 160
             A 75 75 0 0 0 155 210
             A 50 50 0 0 0 140 330 Z"
            fill="url(#cloudGradient)"
            filter="url(#innerHighlight)" />
    </g>
</svg>
